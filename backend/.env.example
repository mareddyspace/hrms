# Copy this file to .env and fill in the values. .env is never committed.

# Neon: Dashboard → Connect → Connection string (pooled). Starts with postgresql://
DATABASE_URL=

# Any long random text; signs login tokens.
JWT_SECRET=

# The portal addresses allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# AI Copilot through OpenRouter (https://openrouter.ai). Leave empty to use the built-in answers.
OPENROUTER_API_KEY=
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Tried in order when the main model is busy.
AI_MODEL_FALLBACKS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free

# ---- hosting (Render sets these from render.yaml; see DEPLOY.md) ----
# production = strict start-up checks (strong JWT_SECRET) and HSTS.
APP_ENV=development
# Extra allowed portal origins as a regular expression (e.g. Vercel preview URLs). Optional.
CORS_ORIGIN_REGEX=
# false hides /docs and /openapi.json.
DOCS_ENABLED=true
LOG_LEVEL=INFO
# true = run database migrations once at start-up.
RUN_MIGRATIONS_ON_START=false
# Local testing only: profile verification codes are returned to the browser.
OTP_DEV_ECHO=false

# File storage: local (folder STORAGE_DIR) or s3 (Backblaze B2 or any S3-compatible bucket).
STORAGE_BACKEND=local
STORAGE_DIR=./storage
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
